<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; Henad's boids rule in NetLogo, for the cross-engine benchmarks.
;;
;; A copy of crates/henad-models/tests/fixtures/boids/boids_netlogo.nlogox, which is the model
;; the committed boids fixtures came from. Two changes on top of it. `setup-bench` at the bottom
;; is new, and the `world-size` global is gone. Each axis now wraps on its own period, both in
;; `wrap-delta` and in `export-agents`. That original only ever ran the two gate scenarios, both
;; on a square world, where the two spellings agree. A timed run takes `--world W H` and can be
;; a rectangle.

globals [ visual-range protected-range sep-factor coh-factor ali-factor max-speed min-speed ]
turtles-own [ vx vy nvx nvy ]

to setup-boids-8
  clear-all
  set visual-range 20     set protected-range 5
  set sep-factor 0.5      set ali-factor 0.25     set coh-factor 0.125
  set max-speed 8         set min-speed 2
  ;; Turtles are created in list order, so `who` matches the scenario index.
  foreach [ [10 10 1 0] [13 10 1 0] [30 30 0 2] [42 30 2 0]
            [75 75 0.5 0.5] [2 50 -3 0] [98 50 3 0] [60 10 6 6] ] [ a ->
    create-turtles 1 [
      setxy (item 0 a) (item 1 a)
      set vx item 2 a   set vy item 3 a
      set heading atan vx vy
    ]
  ]
  reset-ticks
end

to setup-sine-42
  setup-boids-8          ;; reuse the parameter block
  ask turtles [ die ]
  ;; Pre-evaluated sine, snapped to a 1/8 lattice. Do not recompute these with `sin`.
  foreach [
            [0.0 61.125 2.0 0.0] [2.25 73.5 2.375 2.875] [4.625 83.75 -1.25 5.375]
            [6.875 91.0 -6.5 3.125] [9.125 94.625 -8.125 -3.875] [11.375 94.25 -2.375 -10.5]
            [13.75 90.0 1.25 -1.625] [16.0 82.25 3.75 0.0] [18.25 71.5 3.375 4.25]
            [20.625 58.875 -1.625 7.125] [22.875 45.5 -8.125 3.875] [25.125 32.5 -9.625 -4.625]
            [27.375 21.0 -0.5 -2.0] [29.75 12.125 2.375 -2.875] [32.0 6.625 5.5 0.0]
            [34.25 5.0 4.5 5.625] [36.625 7.375 -2.0 8.75] [38.875 13.5 -9.625 4.625]
            [41.125 22.875 -1.75 -0.875] [43.375 34.625 -0.875 -3.625] [45.75 47.75 3.375 -4.25]
            [48.0 61.125 7.25 0.0] [50.25 73.5 5.625 7.0] [52.625 83.75 -2.375 10.5]
            [54.875 91.0 -1.75 0.875] [57.125 94.625 -3.375 -1.625] [59.375 94.25 -1.25 -5.375]
            [61.75 90.0 4.5 -5.625] [64.0 82.25 9.0 0.0] [66.25 71.5 6.75 8.375]
            [68.625 58.875 -0.5 2.0] [70.875 45.5 -3.375 1.625] [73.125 32.5 -5.0 -2.375]
            [75.375 21.0 -1.625 -7.125] [77.75 12.125 5.625 -7.0] [80.0 6.625 10.75 0.0]
            [82.25 5.0 1.25 1.625] [84.625 7.375 -0.875 3.625] [86.875 13.5 -5.0 2.375]
            [89.125 22.875 -6.5 -3.125] [91.375 34.625 -2.0 -8.75] [93.75 47.75 6.75 -8.375]
  ] [ a ->
    create-turtles 1 [
      setxy (item 0 a) (item 1 a)
      set vx item 2 a   set vy item 3 a
      set heading atan vx vy
    ]
  ]
  reset-ticks
end

;; Shortest signed offset along one axis of the torus, over that axis's own period.
to-report wrap-delta [ d period ]
  let h period / 2
  report ifelse-value (d > h) [ d - period ]
         [ ifelse-value (d < (0 - h)) [ d + period ] [ d ] ]
end

to go
  ;; Two passes, so no agent sees a neighbour that has already moved. `ask` is sequential,
  ;; so computing and applying in one pass would make the result order-dependent.
  ask turtles [ compute-velocity ]
  ask turtles [
    set vx nvx
    set vy nvy
    ;; Display only. `atan x y` reports NetLogo's heading convention (0 = north, clockwise);
    ;; the clamp guarantees a non-zero speed, so it is never `atan 0 0`, which is an error.
    set heading atan vx vy
    setxy (xcor + vx) (ycor + vy)     ;; the wrapping world folds these back in
  ]
  tick
end

to compute-velocity
  let myx xcor    let myy ycor    let myvx vx    let myvy vy
  let close-dx 0   let close-dy 0
  let avg-vx 0     let avg-vy 0
  let sum-dx 0     let sum-dy 0
  let n 0
  ;; `in-radius` is inclusive, Henad's test is strict, so this is a candidate set the loop
  ;; filters exactly — the same shape as the spatial hash query it is checking.
  foreach sort (other turtles in-radius visual-range) [ t ->
    ;; `off-x`/`off-y`, not `dx`/`dy` — those two are built-in NetLogo reporters.
    let off-x wrap-delta (([xcor] of t) - myx) world-width
    let off-y wrap-delta (([ycor] of t) - myy) world-height
    let d2 off-x * off-x + off-y * off-y
    if d2 < protected-range * protected-range [
      set close-dx close-dx - off-x
      set close-dy close-dy - off-y
    ]
    if d2 < visual-range * visual-range [
      set avg-vx avg-vx + [vx] of t
      set avg-vy avg-vy + [vy] of t
      set sum-dx sum-dx + off-x
      set sum-dy sum-dy + off-y
      set n n + 1
    ]
  ]
  let newvx myvx + close-dx * sep-factor
  let newvy myvy + close-dy * sep-factor
  if n > 0 [
    set newvx newvx + (avg-vx / n - myvx) * ali-factor + (sum-dx / n) * coh-factor
    set newvy newvy + (avg-vy / n - myvy) * ali-factor + (sum-dy / n) * coh-factor
  ]
  let sp sqrt (newvx * newvx + newvy * newvy)
  ifelse sp > 0 [
    if sp > max-speed [ set newvx newvx / sp * max-speed   set newvy newvy / sp * max-speed ]
    if sp < min-speed [ set newvx newvx / sp * min-speed   set newvy newvy / sp * min-speed ]
  ] [
    set newvx min-speed
    set newvy 0
  ]
  set nvx newvx
  set nvy newvy
end

to export-agents [ filename scenario-name steps ]
  if file-exists? filename [ file-delete filename ]
  file-open filename
  file-print (word "# engine: NetLogo " netlogo-version)
  file-print "# model: Henad boids rule, ported for this comparison"
  file-print (word "# scenario: " scenario-name)
  file-print (word "# steps: " steps)
  file-print (word "# world: " world-width)
  file-print (word "# generated: " date-and-time)
  ;; sort gives `who` order, matching the scenario indices. `mod` maps NetLogo's
  ;; [-0.5, 99.5) back onto Henad's [0, 100) — same torus, different representative.
  foreach sort turtles [ t ->
    file-print (word (([xcor] of t) mod world-width) " " (([ycor] of t) mod world-height)
                     " " ([vx] of t) " " ([vy] of t))
  ]
  file-close
end

;; --- Benchmark setup ------------------------------------------------------------------
;; The two gate scenarios hard-code both the population and the parameters, so a timed run gets
;; a setup of its own.

to setup-bench [ n vr pr sep ali coh maxs mins ]
  clear-all
  set visual-range vr     set protected-range pr
  set sep-factor sep      set ali-factor ali      set coh-factor coh
  set max-speed maxs      set min-speed mins
  ;; Henad starts the flock at the middle of the speed band on a uniform heading.
  let speed 0.5 * (mins + maxs)
  create-turtles n [
    setxy random-xcor random-ycor
    let a random-float 360
    set vx speed * sin a
    set vy speed * cos a
    set heading a
  ]
  reset-ticks
end
]]></code>
